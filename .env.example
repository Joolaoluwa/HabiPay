# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get this from your Neon project dashboard → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ─── Mailer (Gmail SMTP) ──────────────────────────────────────────────────────
# Use a Gmail App Password, NOT your actual Gmail password
# Enable at: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# ─── Encryption (BVN / NIN) ───────────────────────────────────────────────────
# Must be exactly 64 hex characters (32 bytes for AES-256)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_character_hex_encryption_key_here
